{
  "name": "tessera",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "TESSERA_DB_PATH=${TESSERA_DB_PATH:-data/dev/tessera.db} next dev -H 127.0.0.1 -p ${PORT:-3001}",
    "build": "next build",
    "start": "next start",
    "live": "bash scripts/live.sh start",
    "live:update": "bash scripts/live.sh update",
    "live:rollback": "bash scripts/live.sh rollback",
    "live:stop": "bash scripts/live.sh stop",
    "live:status": "bash scripts/live.sh status",
    "lint": "eslint",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run check:conventions && npm run check:licenses && npm run check:theme",
    "check:conventions": "tsx scripts/check-conventions.ts",
    "check:licenses": "tsx scripts/check-licenses.ts",
    "check:bundle": "tsx scripts/check-bundle.ts",
    "check:theme": "npm run astryx -- theme build --check src/themes/catppuccin/catppuccinTheme.ts && npm run astryx -- doctor",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:demo": "tsx scripts/db-demo.ts",
    "db:fts-rebuild": "tsx scripts/fts-rebuild.ts",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:restore": "tsx scripts/db-restore.ts",
    "maintenance": "tsx scripts/maintenance.ts",
    "perf:seed": "tsx scripts/perf-seed.ts",
    "perf:bench": "tsx scripts/perf-bench.ts",
    "mcp:stdio": "tsx scripts/mcp-stdio.ts",
    "automations": "tsx scripts/automations.ts",
    "import:handbook": "tsx scripts/import-handbook.ts",
    "test:e2e": "playwright test",
    "check:e2e": "next build && npm run check:bundle && playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@astryxdesign/cli": "0.7.11",
    "@astryxdesign/core": "0.7.11",
    "@modelcontextprotocol/server": "2.3.1",
    "@next/env": "16.4.3",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-virtual": "3.14.19",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-code-block-lowlight": "3.31.4",
    "@tiptap/extension-drag-handle": "3.31.4",
    "@tiptap/extension-drag-handle-react": "3.31.4",
    "@tiptap/extension-link": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extension-mention": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@tiptap/suggestion": "3.31.4",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "drizzle-zod": "0.8.3",
    "fractional-indexing": "4.0.0",
    "lowlight": "3.3.0",
    "mcp-handler": "^2.3.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-is": "19.3.0",
    "recharts": "3.10.1",
    "uuid": "14.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "30.1.2",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.3"
  },
  "description": "Tessera: an AI-first local work tracker",
  "engines": {
    "node": ">=22.14"
  }
}
