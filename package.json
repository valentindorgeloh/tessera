    "@milkdown/react": "^7.22.2",
    "@modelcontextprotocol/server": "2.3.1",
    "@next/env": "16.4.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-code-block-lowlight": "3.31.4",
    "@tiptap/extension-drag-handle": "3.31.4",
    "@tiptap/extension-drag-handle-react": "3.31.4",
    "@tiptap/extension-link": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extension-mention": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@tiptap/suggestion": "3.31.4",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "drizzle-zod": "0.8.3",
    "fractional-indexing": "4.0.0",
    "lowlight": "3.3.0",
    "mcp-handler": "^2.3.0",
