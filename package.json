{
  "name": "tessera",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run check:conventions && npm run check:licenses",
    "check:conventions": "tsx scripts/check-conventions.ts",
    "check:licenses": "tsx scripts/check-licenses.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:fts-rebuild": "tsx scripts/fts-rebuild.ts",
    "db:backup": "tsx scripts/db-backup.ts",
    "mcp:stdio": "tsx scripts/mcp-stdio.ts",
    "automations": "tsx scripts/automations.ts",
    "import:handbook": "tsx scripts/import-handbook.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@astryxdesign/cli": "^0.6.0",
    "@astryxdesign/core": "^0.6.0",
