# Tessera environment. Copy to .env.local (gitignored). All values optional.

# SQLite file, resolved against the repo root. Backups land next to it under data/backups/.
TESSERA_DB_PATH=data/tessera.db

# Anthropic credentials: set the key here OR run `ant auth login` once (the SDK picks up the profile).
ANTHROPIC_API_KEY=

# Assistant model and effort (effort: low | medium | high | xhigh).
TESSERA_AI_MODEL=claude-opus-5-5
TESSERA_AI_EFFORT=high
